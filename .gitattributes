# Not archived
#
# /.docker still exists (one leftover file, .docker/test/php.ini, predating the
# docker/ restructure) and stays excluded for that reason; monorepo-builder.php
# is genuinely gone (Phase 3 deleted it) and /docs now carries real, worth-keeping
# documentation instead of a stub, so both of those are dropped below.
/.docker export-ignore
/.github export-ignore
/tests export-ignore
# tools/ is excluded file by file rather than as a directory, because git does not
# descend into an export-ignored directory and so cannot re-include a subdirectory.
# tools/patches/ MUST ship: extra.patches points at those files, and a tarball
# without them makes the patcher print "Could not apply patch! Skipping" and produce
# a silently unpatched vendor tree. When adding a QA config here, add it below too.
/tools/.coveralls.yml export-ignore
/tools/infection.json export-ignore
/tools/phpcs.xml export-ignore
/tools/phpstan-bootstrap.php export-ignore
/tools/phpstan.neon export-ignore
/tools/phpstan.tests.neon export-ignore
/tools/phpunit-bootstrap.php export-ignore
/tools/phpunit.xml export-ignore
/var export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
# Anchored to the root. Unanchored, the pattern matched docker/dev/ and docker/prod/ as
# well, and `git archive` (so a Packagist or GitHub source tarball) then shipped the
# images' Dockerfiles with neither compose file to run them. The root file only
# includes docker/dev, which still ships.
/docker-compose.yml export-ignore
Makefile export-ignore
