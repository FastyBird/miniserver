# FastyBird MiniServer - development only, loaded only when there is no frontend build
#
# docker/dev/php/docker-entrypoint.sh points FB_CONFIG_DIR here when public/ holds no
# manifest.json, that is, before the first `pnpm build`. Production never loads this file:
# its FB_CONFIG_DIR is /data/config and its image builds the frontend.
#
# The placeholder is an empty manifest. It lets the DI container compile, which is all the
# dev PHP services need: the JSON:API and the WebSocket server never read the manifest, and
# the one template that does is not routed (see docs/architecture.md). With the Vite dev
# server cookie set, contributte/vite serves assets from the ui-server instead.

contributteVite:
    manifestFile: %appDir%/docker/dev/php/no-frontend-build/vite-manifest.json
