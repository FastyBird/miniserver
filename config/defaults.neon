parameters:
    logger:
        rotatingFile:
            enabled: true
            level: 200
        stdOut:
            enabled: %debugMode%
            level: 200
        console:
            enabled: %debugMode%
            level: 200

    database:
        version: 'mariadb-10.11.0'
        host: 127.0.0.1
        port: 3306
        driver: pdo_mysql
        memory: false
        dbname: miniserver
        username: miniserver
        password: miniserver

    redis:
        host: 127.0.0.1
        port: 6379
        username:
        password:

    server:
        address: 0.0.0.0
        port: 8000
        certificate:

    sockets:
        address: 0.0.0.0
        port: 8888

    security:
        issuer: com.fastybird.miniserver
        signature:                                # set via FB_APP_PARAMETER__SECURITY_SIGNATURE or config/local.neon, see docs/configuration.md

    api:
        prefixed:
            modules: true

    modules:
        exchange: false
