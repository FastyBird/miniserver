#
# Shared test database connection, included by every extension's tests/common.neon.
#
# Each extension's own common.neon overrides only nettrineDbal.connections.default.wrapperClass.
# The %database.*% parameters below are the defaults; FB_APP_PARAMETER__DATABASE_HOST and
# siblings (see Boot\Bootstrap::loadEnvParameters()) take precedence over them, since Nette
# static parameters are compiled in after every addConfig()-loaded file regardless of call
# order.

parameters:
    database:
        version: 'mariadb-10.11.0'
        host: 127.0.0.1
        port: 3306
        driver: pdo_mysql

nettrineDbal:
    connections:
        default:
            serverVersion: %database.version%
            host: %database.host%
            port: %database.port%
            driver: %database.driver%
            dbname: testdb
            user: root
            password: root
            charset: utf8mb4
            # The only place table options are set. Every generated CREATE TABLE carries them
            # explicitly, so the schema does not depend on the server's default collation.
            defaultTableOptions:
                charset: utf8mb4
                collation: utf8mb4_general_ci

    types:
        uuid_binary: Ramsey\Uuid\Doctrine\UuidBinaryType

    typesMapping:
        uuid_binary: binary

    debug:
        panel: false
