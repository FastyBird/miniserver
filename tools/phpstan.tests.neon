includes:
    - ../tests/PHPStan/conditional.config.php

parameters:
    level: max

    tmpDir: ../var/tools/PHPStan
    resultCachePath: %currentWorkingDirectory%/var/tools/PHPStan/resultCache.tests.php

    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true

    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkInternalClassCaseSensitivity: true

    bootstrapFiles:
        - phpstan-bootstrap.php

    paths:
        - ../src/FastyBird/Addon/VirtualThermostat/tests/cases
        - ../src/FastyBird/Automator/DateTime/tests/cases
        - ../src/FastyBird/Automator/DevicesModule/tests/cases
        - ../src/FastyBird/Bridge/DevicesModuleUiModule/tests/cases
        - ../src/FastyBird/Bridge/RedisDbPluginDevicesModule/tests/cases
        - ../src/FastyBird/Bridge/RedisDbPluginTriggersModule/tests/cases
        - ../src/FastyBird/Bridge/ShellyConnectorHomeKitConnector/tests/cases
        - ../src/FastyBird/Bridge/VieraConnectorHomeKitConnector/tests/cases
        - ../src/FastyBird/Bridge/VirtualThermostatAddonHomeKitConnector/tests/cases
        - ../src/FastyBird/Connector/FbMqtt/tests/cases
        - ../src/FastyBird/Connector/HomeKit/tests/cases
        - ../src/FastyBird/Connector/Modbus/tests/cases
        - ../src/FastyBird/Connector/NsPanel/tests/cases
        - ../src/FastyBird/Connector/Shelly/tests/cases
        - ../src/FastyBird/Connector/Sonoff/tests/cases
        - ../src/FastyBird/Connector/Tuya/tests/cases
        - ../src/FastyBird/Connector/Viera/tests/cases
        - ../src/FastyBird/Connector/Virtual/tests/cases
        - ../src/FastyBird/Connector/Zigbee2Mqtt/tests/cases
        - ../src/FastyBird/Core/Application/tests/cases
        - ../src/FastyBird/Core/Exchange/tests/cases
        - ../src/FastyBird/Core/Tools/tests/cases
        - ../src/FastyBird/Library/Metadata/tests/cases
        - ../src/FastyBird/Module/Accounts/tests/cases
        - ../src/FastyBird/Module/Devices/tests/cases
        - ../src/FastyBird/Module/Triggers/tests/cases
        - ../src/FastyBird/Module/Ui/tests/cases
        - ../src/FastyBird/Plugin/ApiKey/tests/cases
        - ../src/FastyBird/Plugin/CouchDb/tests/cases
        - ../src/FastyBird/Plugin/RabbitMq/tests/cases
        - ../src/FastyBird/Plugin/RedisDb/tests/cases
        - ../src/FastyBird/Plugin/RedisDbCache/tests/cases
        - ../src/FastyBird/Plugin/WebServer/tests/cases
        - ../src/FastyBird/Plugin/WsServer/tests/cases

    scanDirectories:
        - ../src/FastyBird/Addon/VirtualThermostat/src
        - ../src/FastyBird/Automator/DateTime/src
        - ../src/FastyBird/Automator/DevicesModule/src
        - ../src/FastyBird/Bridge/DevicesModuleUiModule/src
        - ../src/FastyBird/Bridge/RedisDbPluginDevicesModule/src
        - ../src/FastyBird/Bridge/RedisDbPluginTriggersModule/src
        - ../src/FastyBird/Bridge/ShellyConnectorHomeKitConnector/src
        - ../src/FastyBird/Bridge/VieraConnectorHomeKitConnector/src
        - ../src/FastyBird/Bridge/VirtualThermostatAddonHomeKitConnector/src
