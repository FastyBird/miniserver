<?xml version="1.0"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         bootstrap="./phpunit-bootstrap.php"
         beStrictAboutOutputDuringTests="true"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         stderr="true"
         cacheDirectory="../var/tools/PHPUnit/.phpunit.cache"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
>
    <!--
        The application-scope tier. Everything under src/FastyBird/*/tests boots exactly ONE
        extension, because tools/phpunit-bootstrap.php points FB_APP_DIR at <repo>/tests,
        which has no config/ directory, so config/common.neon and its 45 extension
        registrations are silently skipped. Production registers 22. These tests boot the
        real thing in a child process and are the only ones that can see a defect which only
        appears when every extension is present.
    -->
    <!--
        Enumerated explicitly, one <directory> per package, rather than the `**`
        globs this block used before. Unlike PHP's own glob() (see the coverage
        filter comment below), PHPUnit's own directory resolution follows symlinks
        and treats `**` as a true globstar: pnpm workspace-links a member's entire
        package root into every consumer's node_modules (e.g.
        src/FastyBird/Connector/HomeKit/node_modules/@fastybird/devices-module ->
        ../../../../Module/Devices), so a glob like `Connector/**/tests/cases/`
        also discovers Module/Devices/tests/cases/ a second time through that
        symlink. PHPUnit 10 tolerated the resulting duplicate silently; PHPUnit 11
        errors on it ("Cannot add file ... as it was already added"). A <exclude>
        for node_modules does not reliably fix this: upstream tracks <exclude>
        not applying when a sibling <directory> entry uses a glob pattern
        (sebastianbergmann/phpunit#2815), so the glob itself has to go, not just
        be patched around. An explicit path can't be reached through a symlink
        the way a recursive pattern can, and matches this project's own existing
        convention: tools/phpstan.neon's `paths:` already enumerates every
        package explicitly rather than globbing, for the same reason.
    -->
    <testsuite name="all">
        <directory>../tests/cases/</directory>
        <directory>../src/FastyBird/Addon/VirtualThermostat/tests/cases/</directory>
        <directory>../src/FastyBird/Automator/DateTime/tests/cases/</directory>
        <directory>../src/FastyBird/Automator/DevicesModule/tests/cases/</directory>
        <directory>../src/FastyBird/Bridge/DevicesModuleUiModule/tests/cases/</directory>
        <directory>../src/FastyBird/Bridge/RedisDbPluginDevicesModule/tests/cases/</directory>
        <directory>../src/FastyBird/Bridge/RedisDbPluginTriggersModule/tests/cases/</directory>
        <directory>../src/FastyBird/Bridge/ShellyConnectorHomeKitConnector/tests/cases/</directory>
        <directory>../src/FastyBird/Bridge/VieraConnectorHomeKitConnector/tests/cases/</directory>
        <directory>../src/FastyBird/Bridge/VirtualThermostatAddonHomeKitConnector/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/FbMqtt/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/HomeKit/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Modbus/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/NsPanel/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Shelly/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Sonoff/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Tuya/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Viera/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Virtual/tests/cases/</directory>
        <directory>../src/FastyBird/Connector/Zigbee2Mqtt/tests/cases/</directory>
        <directory>../src/FastyBird/Core/Core/tests/cases/</directory>
        <directory>../src/FastyBird/Module/Accounts/tests/cases/</directory>
        <directory>../src/FastyBird/Module/Devices/tests/cases/</directory>
        <directory>../src/FastyBird/Module/Triggers/tests/cases/</directory>
        <directory>../src/FastyBird/Module/Ui/tests/cases/</directory>
        <directory>../src/FastyBird/Plugin/ApiKey/tests/cases/</directory>
        <directory>../src/FastyBird/Plugin/CouchDb/tests/cases/</directory>
        <directory>../src/FastyBird/Plugin/RabbitMq/tests/cases/</directory>
        <directory>../src/FastyBird/Plugin/RedisDb/tests/cases/</directory>
        <directory>../src/FastyBird/Plugin/RedisDbCache/tests/cases/</directory>
    </testsuite>
    <coverage/>
    <!--
        coverage's own cacheDirectory attribute is gone: PHPUnit 11 folded the
        coverage static-analysis cache into the single root-level cacheDirectory
        above (var/tools/PHPUnit/.phpunit.cache/code-coverage/, confirmed
        populated on disk). The old value, var/tools/PHPUnit/coverage/, was never
        read by the Loader and that directory has never existed. PHPUnit's own
        configuration migrator (the migrate-configuration CLI flag) removes
        this attribute for the same reason
        (RemoveCoverageElementCacheDirectoryAttribute).
    -->
    <!--
        The coverage filter must list the SOURCE, not the tests. Until this was
        fixed it listed the tests/cases directories, so `make coverage-clover`
        reported on 232 test classes and zero source files, and
        `make mutations-infection` (which runs with the skip-initial-tests flag
        over infection.json's `src/FastyBird/*/*/src`) found no coverage data
        for a single mutated file and classified every mutant uncovered.
        Mutation testing was dead and said nothing about it.

        `*/src` rather than `**`: PHP's glob() has no globstar, so `**`
        collapses to exactly one level. `src/FastyBird/*/*/src` resolves to the
        34 source directories (2801 files), the same 34 PHPStan analyses, and
        byte for byte the glob tools/infection.json already uses, so the
        coverage filter and the mutation source set now agree by construction.

        There is deliberately no exclude element. The old one listed `./src/`,
        which PHPUnit resolves against this file's own directory, i.e.
        `tools/src/FastyBird/`, which does not exist, so realpath() returned
        false and the exclude list was empty anyway. With include pointing at
        /src there is nothing left to exclude: fixtures and dummies live in
        tests/, and frontend assets are .ts and are filtered by suffix=".php".
        Repairing it to `../` would be actively harmful: it would exclude
        `tests`, and under the old include that was a parent of the included
        directories, which would have zeroed the filter entirely.
    -->
    <!--
        restrictDeprecations keeps the deprecation report to code this project
        owns, which is the same default that the configuration template
        PHPUnit itself generates carries. Collector::testTriggeredPhpDeprecation() drops any
        deprecation whose file is outside the <include> set below.

        Without it the PHP 8.4 run reports 158 deprecations and writes roughly
        28,000 lines of detail, none of it actionable: they all come from vendor
        code tripping the implicitly-nullable-parameter deprecation
        (thecodingmachine/safe through infection, illuminate/* through
        mathsolver). Those are tracked in docs/deprecations.md, not here, and
        burying our own deprecations under them is the opposite of what the
        report is for.

        This cannot change pass or fail: failOnDeprecation is not set.

        Kept as restrictDeprecations rather than renamed to PHPUnit 11.1's
        ignoreIndirectDeprecations, which the migrate-configuration CLI flag
        suggests and which schema/11.4.xsd (and the current 11.5 schema, vendor/phpunit/
        phpunit/phpunit.xsd) no longer declare. The two are not equivalent:
        restrictDeprecations (still parsed by Xml/Loader.php, still enforced by
        Runner/IssueFilter.php in 11.5.56) filters by whether the triggering
        file is inside the <include> set below; ignoreIndirectDeprecations
        filters by whether the trigger was direct or indirect in the call
        stack, an unrelated axis that was not verified here to drop the same
        158 vendor-noise deprecations. Renaming on faith would trade a known,
        working, documented filter for an unverified one just to silence a
        cosmetic notice. The resulting "Your XML configuration validates
        against a deprecated schema" PHPUnit test runner deprecation (one per
        paratest worker process, hence e.g. 11 with -p11) is accepted as a
        known, non-blocking finding rather than chased further.
    -->
    <source restrictDeprecations="true">
        <include>
            <directory suffix=".php">../src/FastyBird/Addon/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Automator/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Bridge/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Connector/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Core/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Library/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Module/*/src</directory>
            <directory suffix=".php">../src/FastyBird/Plugin/*/src</directory>
        </include>
    </source>
</phpunit>
