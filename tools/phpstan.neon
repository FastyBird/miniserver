includes:
    - phpstan-baseline.neon
    - ../tests/PHPStan/conditional.config.php

parameters:
    level: max

    # Pinned so static analysis does not silently follow whatever PHP the runner
    # happens to have. A no-op today, and that is the point: without it, Task 31's
    # runtime bump would shift PHPStan's result with no way to attribute the delta.
    phpVersion: 80200

    tmpDir: ../var/tools/PHPStan
    resultCachePath: %currentWorkingDirectory%/var/tools/PHPStan/resultCache.src.php

    exceptions:
        check:
            missingCheckedExceptionInThrows: true
            tooWideThrowType: true

    checkMissingCallableSignature: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkInternalClassCaseSensitivity: true

    bootstrapFiles:
        - phpstan-bootstrap.php

    stubFiles:
        - ../tests/stubs/BaseLinkInterface.stub
        - ../tests/stubs/ContextInterface.stub
        - ../tests/stubs/LinkInterface.stub
        - ../tests/stubs/PositionInterface.stub
        - ../tests/stubs/SchemaInterface.stub
        - ../tests/stubs/RedisClient.stub
        - ../tests/stubs/EventEmitterInterface.stub

    paths:
        - ../src/FastyBird/Addon/VirtualThermostat/src
        - ../src/FastyBird/Automator/DateTime/src
        - ../src/FastyBird/Automator/DevicesModule/src
        - ../src/FastyBird/Bridge/DevicesModuleUiModule/src
        - ../src/FastyBird/Bridge/RedisDbPluginDevicesModule/src
        - ../src/FastyBird/Bridge/RedisDbPluginTriggersModule/src
        - ../src/FastyBird/Bridge/ShellyConnectorHomeKitConnector/src
        - ../src/FastyBird/Bridge/VieraConnectorHomeKitConnector/src
        - ../src/FastyBird/Bridge/VirtualThermostatAddonHomeKitConnector/src
        - ../src/FastyBird/Connector/FbMqtt/src
        - ../src/FastyBird/Connector/HomeKit/src
        - ../src/FastyBird/Connector/Modbus/src
        - ../src/FastyBird/Connector/NsPanel/src
        - ../src/FastyBird/Connector/Shelly/src
        - ../src/FastyBird/Connector/Sonoff/src
        - ../src/FastyBird/Connector/Tuya/src
        - ../src/FastyBird/Connector/Viera/src
        - ../src/FastyBird/Connector/Virtual/src
        - ../src/FastyBird/Connector/Zigbee2Mqtt/src
        - ../src/FastyBird/Core/Application/src
        - ../src/FastyBird/Core/Application/bin
        - ../src/FastyBird/Core/Exchange/src
        - ../src/FastyBird/Core/Tools/src
        - ../src/FastyBird/Library/Metadata/src
        - ../src/FastyBird/Module/Accounts/src
        - ../src/FastyBird/Module/Devices/src
        - ../src/FastyBird/Module/Triggers/src
        - ../src/FastyBird/Module/Ui/src
        - ../src/FastyBird/Plugin/ApiKey/src
        - ../src/FastyBird/Plugin/CouchDb/src
        - ../src/FastyBird/Plugin/RabbitMq/src
        - ../src/FastyBird/Plugin/RedisDb/src
        - ../src/FastyBird/Plugin/RedisDbCache/src
        - ../src/FastyBird/Plugin/WebServer/src
        - ../src/FastyBird/Plugin/WsServer/src

    excludePaths:
        analyseAndScan:
            - ../src/FastyBird/Core/Application/src/EventLoop/Wrapper.php
