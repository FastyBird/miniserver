# FastyBird MiniServer -- Docker Compose variable substitution template.
# Copy this file to `.env` and adjust for your deployment. docker-compose
# reads `.env` automatically for `${VAR:-default}` substitution in the
# compose files under docker/dev/ and docker/prod/. All variables here are
# optional; the default shown in each compose file is used when unset. Not
# every variable applies to both compose files -- see the per-section notes.

# Container timezone (both compose files).
APP_TZ=UTC

# Signs authentication tokens (fbSimpleAuth). STRONGLY set this in production --
# docker/prod/docker-compose.yml has no fallback default for this one on purpose,
# and the production entrypoint generates and persists a random value into
# config/local.neon on first start if it is left unset. Setting it explicitly
# means every replica of a multi-instance deployment shares the same signature,
# and that the signature survives recreating the /data volume. Losing it
# invalidates every token issued under it. Generate one with: openssl rand -base64 32
SECURITY_SIGNATURE=

# Database credentials, consumed as FB_APP_PARAMETER__DATABASE_* by the application
# and as MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE by the database service.
DATABASE_USERNAME=miniserver
DATABASE_PASSWORD=miniserver
DATABASE_DBNAME=miniserver
ROOT_PASSWORD=root

# Whether API routes are prefixed by module name (docker/dev only).
API_PREFIXED_MODULES=true

# Ports published on the host.
HTTP_PORT=80
WS_PORT=8888

# docker/dev only.
WEB_SERVER_PORT=80
UI_PORT=3000
UI_DOC_PORT=6006
MYSQL_PORT=3306
REDIS_PORT=6379

# Only used when the couchdb, rabbitmq or mqtt Compose profile is enabled
# (docker/dev only -- docker/prod has no couchdb/rabbitmq/mqtt services).
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=admin
COUCHDB_PORT=5984
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MQTT_PORT=1883

# Only used with docker/dev/docker-compose.lan.yml (macvlan override).
LOCAL_NETWORK_APPLICATION_IP_ADDRESS=192.168.0.10
LOCAL_NETWORK_DEVICES_MODULE_IP_ADDRESS=192.168.0.20
LOCAL_NETWORK_SUBNET=192.168.0.0/24
LOCAL_NETWORK_GATEWAY=192.168.0.1
LOCAL_NETWORK_IP_RANGE=192.168.0.6/24
LOCAL_NETWORK_DRIVER=eth0
