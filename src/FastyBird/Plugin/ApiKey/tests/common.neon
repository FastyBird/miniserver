includes:
	- ../../../../../tests/config/dbal-test-connection.neon

php:
	date.timezone: Europe/Prague

extensions:
	contributteTranslation: Contributte\Translation\DI\TranslationExtension
	nettrineDbal: Nettrine\DBAL\DI\DbalExtension
	nettrineOrm: Nettrine\ORM\DI\OrmExtension
	fbCore: FastyBird\Core\DI\CoreExtension

services:
	-
		factory: FastyBird\Core\Http\SlimRouter\ResponseFactory

	-
		factory: FastyBird\Core\Routing\SlimRouter\Router
		setup:
			- addMiddleware(@fbCore.jsonApi.middlewares.jsonapi)

contributteTranslation:
	locales:
		default: en_US
		fallback:
			- en_US
			- en

	localeResolvers: []
	dirs:
		- %appDir%/../src/Translations
		- %vendorDir%/fastybird/json-api-library/src/Translations

nettrineDbal:
	connections:
		default:
			wrapperClass: \FastyBird\Plugin\ApiKey\Tests\Tools\ConnectionWrapper

nettrineOrm:
	managers:
		default:
			connection: default
			lazyNativeObjects: true
			proxyDir: %tempDir%/cache/doctrine.proxies
			autoGenerateProxyClasses: 3

fbCore:
	application:
		documents:
			mapping: []

	jsonApi:
		meta:
			copyright: FastyBird s.r.o

