{
  "name": "fastybird/apikey-plugin",
  "description": "FastyBird IoT api keys management plugin",
  "keywords": [
    "fastybird",
    "fb",
    "libs",
    "library",
    "api",
    "api-key",
    "middleware",
    "access"
  ],
  "homepage": "https://www.fastybird.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "FastyBird s.r.o.",
      "email": "code@fastybird.com",
      "homepage": "https://www.fastybird.com"
    },
    {
      "name": "Adam Kadlec",
      "email": "adam.kadlec@fastybird.com"
    }
  ],
  "support": {
    "email": "code@fastybird.com",
    "issues": "https://github.com/FastyBird/miniserver/issues",
    "source": "https://github.com/FastyBird/miniserver"
  },
  "require": {
    "php": ">=8.4.0",
    "cweagans/composer-patches": "^1.7",
    "fastybird/application": "@dev",
    "fastybird/json-api": "^0.19",
    "fastybird/tools": "@dev",
    "fig/http-message-util": "^1.1",
    "ipub/doctrine-crud": "^5.1",
    "nette/di": "^3.2",
    "nette/utils": "^4.0",
    "psr/http-message": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "ramsey/uuid": "^4.7",
    "react/promise": "^3",
    "symfony/console": "^6.0",
    "symplify/vendor-patches": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "FastyBird\\Plugin\\ApiKey\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FastyBird\\Plugin\\ApiKey\\Tests\\Cases\\Unit\\": "tests/cases/unit",
      "FastyBird\\Plugin\\ApiKey\\Tests\\Tools\\": "tests/tools"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
