{
  "name": "fastybird/redisdb-cache-plugin",
  "description": "FastyBird IoT Redis DB cache",
  "keywords": [
    "fastybird",
    "fb",
    "iot",
    "redisdb",
    "cache"
  ],
  "homepage": "https://www.fastybird.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "FastyBird s.r.o.",
      "email": "code@fastybird.com",
      "homepage": "https://www.fastybird.com/"
    },
    {
      "name": "Adam Kadlec",
      "email": "adam.kadlec@fastybird.com"
    }
  ],
  "support": {
    "email": "code@fastybird.com",
    "issues": "https://github.com/FastyBird/miniserver/issues",
    "source": "https://github.com/FastyBird/miniserver"
  },
  "require": {
    "php": ">=8.4.0",
    "clue/redis-react": "^3@dev",
    "cweagans/composer-patches": "^1.7",
    "nette/caching": "^3.3",
    "nette/di": "^3.2",
    "nette/utils": "^4.0",
    "predis/predis": "^1.1",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "react/async": "^4.0",
    "react/event-loop": "^1.3",
    "react/promise": "^3",
    "react/socket": "^1.12",
    "symfony/event-dispatcher": "^7.0",
    "symplify/vendor-patches": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "FastyBird\\Plugin\\RedisDbCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FastyBird\\Plugin\\RedisDbCache\\Tests\\Cases\\Unit\\": "tests/cases/unit",
      "FastyBird\\Plugin\\RedisDbCache\\Tests\\Tools\\": "tests/tools"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
