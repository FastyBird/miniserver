{
  "name": "fastybird/ws-server-plugin",
  "description": "FastyBird IoT web sockets server plugin for handling real-time communication",
  "keywords": [
    "fastybird",
    "fb",
    "plugin",
    "ws",
    "wamp",
    "wamp-server",
    "ipublikuj",
    "nette",
    "php"
  ],
  "homepage": "https://www.fastybird.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "FastyBird s.r.o.",
      "email": "code@fastybird.com",
      "homepage": "https://www.fastybird.com"
    },
    {
      "name": "Adam Kadlec",
      "email": "adam.kadlec@fastybird.com"
    }
  ],
  "support": {
    "email": "code@fastybird.com",
    "issues": "https://github.com/FastyBird/miniserver/issues",
    "source": "https://github.com/FastyBird/miniserver"
  },
  "require": {
    "php": ">=8.4.0",
    "cweagans/composer-patches": "^1.7",
    "fastybird/application": "@dev",
    "fastybird/exchange": "@dev",
    "fastybird/metadata-library": "@dev",
    "fastybird/tools": "@dev",
    "ipub/websockets-wamp": "^1.4",
    "nette/di": "^3.2",
    "nette/utils": "^4.0",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "react/promise": "^3",
    "react/socket": "^1.12",
    "symfony/console": "^6.0",
    "symfony/event-dispatcher": "^7.0",
    "symplify/vendor-patches": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "FastyBird\\Plugin\\WsServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FastyBird\\Plugin\\WsServer\\Tests\\Cases\\Unit\\": "tests/cases/unit"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
