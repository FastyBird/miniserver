{
  "name": "fastybird/exchange",
  "description": "FastyBird IoT application exchange services",
  "keywords": [
    "exchange",
    "events",
    "fastybird",
    "fb",
    "iot",
    "nette",
    "library",
    "php"
  ],
  "homepage": "https://www.fastybird.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "FastyBird s.r.o.",
      "email": "code@fastybird.com",
      "homepage": "https://www.fastybird.com/"
    },
    {
      "name": "Adam Kadlec",
      "email": "adam.kadlec@fastybird.com"
    }
  ],
  "support": {
    "email": "code@fastybird.com",
    "issues": "https://github.com/FastyBird/miniserver/issues",
    "source": "https://github.com/FastyBird/miniserver"
  },
  "require": {
    "php": ">=8.4.0",
    "cweagans/composer-patches": "^1.7",
    "fastybird/application": "@dev",
    "fastybird/metadata-library": "@dev",
    "nette/di": "^3.2",
    "nette/utils": "^4.0",
    "psr/event-dispatcher": "^1.0",
    "react/promise": "^3",
    "symfony/event-dispatcher": "^7.0",
    "symplify/vendor-patches": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "FastyBird\\Core\\Exchange\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FastyBird\\Core\\Exchange\\Tests\\Cases\\Unit\\": "tests/cases/unit"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
