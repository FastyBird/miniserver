{
  "name": "fastybird/homekit-connector",
  "description": "FastyBird IoT connector for HomeKit Accessory Protocol",
  "keywords": [
    "php",
    "iot",
    "nette",
    "reactphp",
    "fb",
    "homekit",
    "hap-python",
    "fastybird",
    "connector"
  ],
  "homepage": "https://www.fastybird.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "FastyBird s.r.o.",
      "email": "code@fastybird.com",
      "homepage": "https://www.fastybird.com"
    },
    {
      "name": "Adam Kadlec",
      "email": "adam.kadlec@fastybird.com"
    }
  ],
  "support": {
    "email": "code@fastybird.com",
    "issues": "https://github.com/FastyBird/miniserver/issues",
    "source": "https://github.com/FastyBird/miniserver"
  },
  "require": {
    "fastybird/doctrine-orm-query-library": "@dev",
    "php": ">=8.4.0",
    "ext-gmp": "*",
    "ext-pcntl": "*",
    "ext-sockets": "*",
    "ext-sodium": "*",
    "brick/math": "^0.10",
    "contributte/console": "^0.9",
    "contributte/monolog": "^0.6",
    "contributte/translation": "^2.0",
    "cweagans/composer-patches": "^1.7",
    "evenement/evenement": "^3.0",
    "fastybird/application": "@dev",
    "fastybird/devices-module": "@dev",
    "fastybird/exchange": "@dev",
    "fastybird/metadata-library": "@dev",
    "fastybird/tools": "@dev",
    "hashids/hashids": "^4.1",
    "fastybird/slim-router-library": "@dev",
    "leigh/curve25519": "^0.1",
    "nette/di": "^3.2",
    "orisai/object-mapper": "^0.3",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "endroid/qr-code": "^4.5",
    "react/async": "^4.0",
    "react/datagram": "^1.8",
    "react/dns": "^1.10",
    "react/http": "^1.7",
    "react/promise": "^3",
    "simplito/elliptic-php": "^1.0",
    "symfony/event-dispatcher": "^7.0",
    "z4kn4fein/php-semver": "^2.0"
  },
  "require-dev": {
    "symplify/vendor-patches": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "FastyBird\\Connector\\HomeKit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FastyBird\\Connector\\HomeKit\\Tests\\Cases\\Unit\\": "tests/cases/unit",
      "FastyBird\\Connector\\HomeKit\\Tests\\Tools\\": "tests/tools"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
