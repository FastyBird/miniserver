includes:
	- ../../../../../tests/config/dbal-test-connection.neon

php:
	date.timezone: Europe/Prague

extensions:
	contributteTranslation: Contributte\Translation\DI\TranslationExtension
	nettrineDbal: Nettrine\DBAL\DI\DbalExtension
	nettrineOrm: Nettrine\ORM\DI\OrmExtension
	fbDevicesModule: FastyBird\Module\Devices\DI\DevicesExtension
	fbHomeKitConnector: FastyBird\Connector\HomeKit\DI\HomeKitExtension
	fbVirtualConnector: FastyBird\Connector\Virtual\DI\VirtualExtension
	fbVirtualThermostatAddon: FastyBird\Addon\VirtualThermostat\DI\VirtualThermostatExtension
	fbCore: FastyBird\Core\DI\CoreExtension

services:
	cache.storage: Nette\Caching\Storages\DevNullStorage

fbDevicesModule:
	exchange: false

decorator:
	FastyBird\Core\Routing\ServerRouter:
		setup:
			- addMiddleware(@fbCore.jsonApi.middlewares.jsonapi)

contributteTranslation:
	locales:
		default: en_US
		fallback:
			- en_US
			- en

	localeResolvers: []
	dirs:
		- %vendorDir%/fastybird/miniserver-core/src/Translations/JsonApi

nettrineDbal:
	connections:
		default:
			wrapperClass: \FastyBird\Bridge\VirtualThermostatAddonHomeKitConnector\Tests\Tools\ConnectionWrapper

nettrineOrm:
	managers:
		default:
			connection: default
			lazyNativeObjects: true
			proxyDir: %tempDir%/cache/doctrine.proxies
			autoGenerateProxyClasses: 3
			mapping:
				dummy:
					type: attributes
					directories:
						- %appDir%/fixtures/dummy

					namespace: FastyBird\Bridge\VirtualThermostatAddonHomeKitConnector\Tests\Fixtures\Dummy

fbCore:
	application:
		documents:
			mapping:
				FastyBird\Bridge\VirtualThermostatAddonHomeKitConnector\Tests\Fixtures\Dummy: %appDir%/fixtures/dummy

	simpleAuth:
		token:
			issuer: com.fastybird.auth-module
			signature: 'g3xHbkELpMD9LRqW4WmJkHL7kz2bdNYAQJyEuFVzR3k='

		enable:
			middleware: true
			nette:
				application: true

		casbin:
			policy: %appDir%/policy.csv

		services:
			identity: true

	jsonApi:
		meta:
			copyright: FastyBird s.r.o

	dateTimeFactory:
		frozen: DateTimeImmutable('2020-04-01T12:00:00+00:00')

