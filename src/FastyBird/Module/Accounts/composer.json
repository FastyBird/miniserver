{
  "name": "fastybird/accounts-module",
  "description": "FastyBird IoT accounts module for application accounts & access management",
  "keywords": [
    "fastybird",
    "fb",
    "api",
    "php",
    "iot",
    "security",
    "vuejs",
    "vue",
    "nette",
    "accounts",
    "roles",
    "access",
    "vue3",
    "pinia"
  ],
  "homepage": "https://www.fastybird.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "FastyBird s.r.o.",
      "email": "code@fastybird.com",
      "homepage": "https://www.fastybird.com"
    },
    {
      "name": "Adam Kadlec",
      "email": "adam.kadlec@fastybird.com"
    }
  ],
  "support": {
    "email": "code@fastybird.com",
    "issues": "https://github.com/FastyBird/miniserver/issues",
    "source": "https://github.com/FastyBird/miniserver"
  },
  "require": {
    "php": ">=8.4.0",
    "ext-pcntl": "*",
    "contributte/console": "^0.9",
    "contributte/monolog": "^0.5",
    "contributte/translation": "^2.0",
    "cweagans/composer-patches": "^1.7",
    "fastybird/application": "@dev",
    "fastybird/exchange": "@dev",
    "fastybird/json-api": "^0.19",
    "fastybird/metadata-library": "@dev",
    "fastybird/simple-auth": "^0.14",
    "fastybird/tools": "@dev",
    "ipub/slim-router": "^0.2",
    "nettrine/dbal": "^0.8",
    "nettrine/orm": "^0.8",
    "react/promise": "^3",
    "symfony/console": "^6.0",
    "symplify/vendor-patches": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "FastyBird\\Module\\Accounts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FastyBird\\Module\\Accounts\\Tests\\Cases\\Unit\\": "tests/cases/unit",
      "FastyBird\\Module\\Accounts\\Tests\\Fixtures\\": "tests/fixtures",
      "FastyBird\\Module\\Accounts\\Tests\\Tools\\": "tests/tools"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
