includes:
	- ../../../../../tests/config/dbal-test-connection.neon

php:
	date.timezone: Europe/Prague

extensions:
	contributteTranslation: Contributte\Translation\DI\TranslationExtension
	nettrineDbal: Nettrine\DBAL\DI\DbalExtension
	nettrineOrm: Nettrine\ORM\DI\OrmExtension
	fbCore: FastyBird\Core\DI\CoreExtension

services:
	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyConnectorFactory
		tags:
			connector_type: dummy

	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyConnectorSchema

	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyConnectorHydrator

	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyDeviceSchema

	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyDeviceHydrator

	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyChannelSchema

	-
		factory: FastyBird\Module\Devices\Tests\Fixtures\Dummy\DummyChannelHydrator

	cache.storage: Nette\Caching\Storages\DevNullStorage

fbDevicesModule:
	exchange: false

decorator:
	FastyBird\Core\Routing\WebServer\Router:
		setup:
			- addMiddleware(@fbCore.jsonApi.middlewares.jsonapi)

contributteTranslation:
	locales:
		default: en_US
		fallback:
			- en_US
			- en

	localeResolvers: []
	dirs:
		- %appDir%/../src/Translations
		- %vendorDir%/fastybird/miniserver-core/src/Translations/JsonApi

nettrineDbal:
	connections:
		default:
			wrapperClass: \FastyBird\Module\Devices\Tests\Tools\ConnectionWrapper

nettrineOrm:
	managers:
		default:
			connection: default
			lazyNativeObjects: true
			proxyDir: %tempDir%/cache/doctrine.proxies
			autoGenerateProxyClasses: 3
			mapping:
				dummy:
					type: attributes
					directories:
						- %appDir%/fixtures/dummy

					namespace: FastyBird\Module\Devices\Tests\Fixtures\Dummy

fbCore:
	application:
		documents:
			mapping:
				FastyBird\Module\Devices\Tests\Fixtures\Dummy: %appDir%/fixtures/dummy

	simpleAuth:
		token:
			issuer: com.fastybird.auth-module
			signature: 'g3xHbkELpMD9LRqW4WmJkHL7kz2bdNYAQJyEuFVzR3k='

		enable:
			middleware: true
			nette:
				application: true

		casbin:
			policy: %appDir%/policy.csv

		services:
			identity: true

	jsonApi:
		meta:
			copyright: FastyBird s.r.o

	dateTimeFactory:
		frozen: DateTimeImmutable('2020-04-01T12:00:00+00:00')

