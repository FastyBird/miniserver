includes:
	- ../../../../../tests/config/dbal-test-connection.neon

php:
	date.timezone: Europe/Prague

extensions:
	contributteTranslation: Contributte\Translation\DI\TranslationExtension
	nettrineDbal: Nettrine\DBAL\DI\DbalExtension
	nettrineOrm: Nettrine\ORM\DI\OrmExtension
	fbCore: FastyBird\Core\DI\CoreExtension

services:
	-
		factory: FastyBird\Core\Http\SlimRouter\ResponseFactory

	-
		factory: FastyBird\Core\Routing\SlimRouter\Router
		setup:
			- addMiddleware(@fbCore.jsonApi.middlewares.jsonapi)

	-
		factory: FastyBird\Module\Triggers\Tests\Fixtures\Dummy\DummyActionHydrator

	-
		factory: FastyBird\Module\Triggers\Tests\Fixtures\Dummy\DummyActionSchema

	-
		factory: FastyBird\Module\Triggers\Tests\Fixtures\Dummy\DummyConditionSchema

	-
		factory: FastyBird\Module\Triggers\Tests\Fixtures\Dummy\DummyConditionHydrator

	cache.storage: Nette\Caching\Storages\DevNullStorage

decorator: null
contributteTranslation:
	locales:
		default: en_US
		fallback:
			- en_US
			- en

	localeResolvers: []
	dirs:
		- %appDir%/../src/Translations
		- %vendorDir%/fastybird/json-api-library/src/Translations

nettrineDbal:
	connections:
		default:
			wrapperClass: \FastyBird\Module\Triggers\Tests\Tools\ConnectionWrapper

nettrineOrm:
	managers:
		default:
			connection: default
			lazyNativeObjects: true
			proxyDir: %tempDir%/cache/doctrine.proxies
			autoGenerateProxyClasses: 3
			mapping:
				dummy:
					type: attributes
					directories:
						- %appDir%/fixtures/dummy

					namespace: FastyBird\Module\Triggers\Tests\Fixtures\Dummy

fbCore:
	application:
		documents:
			mapping:
				FastyBird\Module\Triggers\Tests\Fixtures\Dummy: %appDir%/fixtures/dummy

	simpleAuth:
		token:
			issuer: com.fastybird.auth-module
			signature: 'g3xHbkELpMD9LRqW4WmJkHL7kz2bdNYAQJyEuFVzR3k='

		enable:
			middleware: true
			nette:
				application: true

		casbin:
			policy: %appDir%/policy.csv

		services:
			identity: true

	jsonApi:
		meta:
			copyright: FastyBird s.r.o

	dateTimeFactory:
		frozen: DateTimeImmutable('2020-04-01T12:00:00+00:00')

