# pnpm's default; pinned explicitly so nobody "tidies it up" by turning it on.
# This is the --ignore-engines replacement: pnpm warns rather than errors on a
# dependency engines mismatch unless engine-strict is true.
engine-strict=false

# Prevents pnpm materialising a second vue-i18n / element-plus / vue inside
# Module/Ui and Module/Triggers from their peerDependencies ranges.
auto-install-peers=false

# The store lives inside node_modules so that it is always on the same device as
# the packages it is hard-linked into. In the dev stack node_modules is a named
# volume shadowing the /app bind mount, so a store at the project root (the old
# `.pnpm-store`) was on the bind mount's device: pnpm silently degraded to copying
# every file (0 of 41,017 hard-linked), and the 35k store files sat inside the
# directory Vite polls. Under node_modules neither holds: it is on the volume, and
# Vite, like the Docker context and git (`**/node_modules`), skips it by default.
store-dir=node_modules/.pnpm-store
